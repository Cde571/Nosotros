{
  "appId": "com.nosotros.desktop",
  "productName": "Nosotros",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "cloud-client.cjs",
    "index.html",
    "app.js",
    "style.css",
    "package.json",
    "cloud-config.js",
    "bridge.js",
    "icons.svg",
    "assets/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "Nosotros-Setup.exe"
  }
}
